# ─────────────────────────────────────────────────────────────────────────────
# MANDATE — environment
#
# The site runs from the committed agent index without any of this. These are
# for indexing, driving the market, and deploying.
# ─────────────────────────────────────────────────────────────────────────────

# ── 8004scan (registry data) ────────────────────────────────────────────────
# Anonymous is 25 req/min; the hackathon Pro tier is 500/min, 100k/day.
SCAN_API_KEY=
SCAN_BASE_URL=https://api.8004scan.io/api/v1

# ── The chain the assay engine reads ────────────────────────────────────────
CHAIN_ID=56
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Optional. Widens the Capability assay from a recent window to full history;
# no free BSC provider serves deep history, and without this the scan is
# bounded and reports itself as such.
ARCHIVE_RPC_URL=

# ── MandateMarket ───────────────────────────────────────────────────────────
# Live on BNB Smart Chain mainnet.
MARKET_ADDRESS=0x6052C0ab83a99Fb37aC598c23b8E369fB21C71B2
NEXT_PUBLIC_MARKET_ADDRESS=0x6052C0ab83a99Fb37aC598c23b8E369fB21C71B2
MARKET_CHAIN_ID=56
NEXT_PUBLIC_MARKET_CHAIN_ID=56
MARKET_RPC_URL=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_MARKET_RPC_URL=https://bsc-dataseed.bnbchain.org
# History starts where the contract does; without it the standings scan guesses
# a lookback and times out.
MARKET_DEPLOY_BLOCK=119898276
NEXT_PUBLIC_MARKET_DEPLOY_BLOCK=119898276
# bsc-dataseed refuses eth_getLogs outright, so log reads need their own host.
LOG_RPC_URL=https://bsc-rpc.publicnode.com

# ── Keys (never commit real values; .env is gitignored) ─────────────────────
# Deployer and contract owner. Also the principal whose Altana account grants
# sessions, and the demo address on /judges.
PRIVATE_KEY=
# Settlement adjudicator. A different key from the owner; proposeEpoch signs
# with this and refuses to run without it.
ADJUDICATOR_KEY=
# House keeper wallets. The keeper bid route (POST /api/keeper/bid) answers
# 503 until AGENT_A_KEY is present on the deployment.
AGENT_A_KEY=
AGENT_A_ADDR=
AGENT_B_KEY=
AGENT_B_ADDR=
# Reference agents, one key each. Their Altana wallets are derived from these.
HOUSE_RANGE_KEY=
HOUSE_GRID_KEY=
HOUSE_YIELD_KEY=
HOUSE_GUARD_KEY=
# Encrypts the secret half of every session at rest (AES-256-GCM). Generate
# with `openssl rand -hex 32`. Must be identical on every machine that
# executes or revokes a session; the site cannot act on sessions without it.
SESSION_SECRET=
# Gates POST /api/sessions/revoke and the revoke form on /desk.
OPERATOR_TOKEN=

# ── Optional: Postgres for the assay indexer ────────────────────────────────
DATABASE_URL=
AGENTS_PER_CYCLE=40
FEEDBACK_PAGES=45
CYCLE_MS=900000

# ── Optional ────────────────────────────────────────────────────────────────
# Signs MCP write tools, and only in the local stdio server (npm run mcp).
# The hosted /api/mcp endpoint never reads it and never signs.
MCP_SIGNER_KEY=
# Authorises /api/cron/daily to force a refresh and run the keeper sweep.
# Without it the route only does what the site would do on its own.
CRON_SECRET=
# Price of one answer from a reference agent over x402, in USD1.
X402_PRICE_HOUSE=0.05
# Who x402 payments to this deployment are made out to.
X402_PAY_TO=
# The grid leash, if you deploy your own SwapBound.
SWAP_BOUND=
RECIPIENT_BOUND=
# Etherscan v2 API key, for BscScan verification (contracts/verify/README.md).
ETHERSCAN_KEY=

# Set to 'on' to let the tick renew a house session before it expires. Each
# renewal is a KeyStore registration paid out of the operator's balance, so
# it is off unless you turn it on; with it off the tick only reports what is
# lapsing.
LEASE_RENEWAL=off

# ── The site ────────────────────────────────────────────────────────────────
# Our own domain. Every published link, API envelope and agent registration
# document is built from it, and mandate-coral.vercel.app redirects to it.
NEXT_PUBLIC_HOST=https://mandatemarkets.com
# Our own ERC-8004 identity and the two house keepers' token ids.
NEXT_PUBLIC_MANDATE_TOKEN_ID=336161
NEXT_PUBLIC_HOUSE_A_TOKEN_ID=
NEXT_PUBLIC_HOUSE_B_TOKEN_ID=
NEXT_PUBLIC_MARKET_V2_ADDRESS=0x6052C0ab83a99Fb37aC598c23b8E369fB21C71B2
# The range agent's leash contract, on the server and in the browser.
RECIPIENT_BOUND=0x5863EDAEDe7394470db19395CA05B1439662952E
NEXT_PUBLIC_RECIPIENT_BOUND=0x5863EDAEDe7394470db19395CA05B1439662952E

# ── Switches that spend (see docs/ops.md) ───────────────────────────────────
# House agents send their own transactions on the site's clock. Unset: dry.
HOUSE_AGENTS=
# Renew house sessions three days before they lapse. Unset: never renews.
LEASE_RENEWAL=
# Escrowed jobs are settled or refunded on the clock. Unset: never.
SWEEPER=
# "Try it free": calls paid by AGENT_A_KEY for a visitor. off to disable.
JUDGE_MODE=
JUDGE_DAILY=10
JUDGE_PER_CALLER=3
JUDGE_MAX_CALL=0.05

# ── Tuning ──────────────────────────────────────────────────────────────────
# Blocks in one PancakeSwap pool-gap window.
POOL_GAP_BLOCKS=4000
# Prices of our paid endpoints, in USD1.
X402_PRICE_STATUS=
X402_PRICE_SIMULATE=
# Smoke test target and patience.
SMOKE_BASE=
SMOKE_TIMEOUT_MS=45000

# ── Scripts only ────────────────────────────────────────────────────────────
# Contract deploys, forks and one-off runs. The site never reads these.
DEPLOYER_PRIVATE_KEY=
DEPLOY_RPC_URL=
FORK_RPC_URL=
ADJUDICATOR_PRIVATE_KEY=
ASSAY_BOND_ADDRESS=
DEMO_ADDRESS=
GREENFIELD_BUCKET=
# A wallet for end-to-end tests on mainnet. Declared to BNB as a team wallet.
TEST_WALLET_KEY=

# Free liquidation alerts (Telegram). Create the bot with @BotFather, then run npm run telegram-setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
