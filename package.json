    "smoke": "tsx src/scripts/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx --env-file=.env --env-file=.env.local src/scripts/db-seed.ts",
    "worker:once": "tsx --env-file=.env --env-file=.env.local src/worker/index.ts --once",
    "value": "tsx src/scripts/value-wallet.ts",
    "test:fork": "anvil --fork-url ${BSC_RPC_URL:-https://bsc-dataseed.bnbchain.org} --port 8549 --silent & sleep 20; FORK_RPC_URL=http://127.0.0.1:8549 vitest run src/lib/chain/valuation/; kill %1",
    "restate": "tsx src/scripts/restate.ts",
    "assay-bond": "tsx --env-file=.env --env-file=.env.local src/scripts/deploy-assay-bond.ts",
    "register-self": "tsx --env-file=.env --env-file=.env.local src/scripts/register-self.ts",
    "register-house": "tsx --env-file=.env --env-file=.env.local src/scripts/register-house.ts",
    "index:field": "tsx --env-file=.env --env-file=.env.local src/scripts/index-field.ts",
    "probe": "tsx --env-file=.env --env-file=.env.local src/scripts/probe.ts",
    "replay": "tsx --env-file=.env --env-file=.env.local src/scripts/replay.ts",
    "resolve-challenge": "tsx --env-file=.env --env-file=.env.local src/scripts/resolve-challenge.ts",
    "db:check": "tsx --env-file=.env --env-file=.env.local src/scripts/db-check.ts",
    "cross-check": "tsx --env-file=.env --env-file=.env.local src/scripts/cross-check.ts",
    "check:agreement": "tsx --env-file=.env --env-file=.env.local src/scripts/cross-check.ts 0xd6d11Aa5046dc5C7BE8d63B9223b60D7AD94cBe9 0x54c06cC2623aAA2Dcc38B17fA07aD2e99b363C90",
    "check:doctrine": "node src/scripts/check-doctrine.mjs",
    "assay:snapshot": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/assay-snapshot.ts",
    "probe:all": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/probe-all.ts",
    "keeper:sweep": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/keeper-sweep.ts",
    "refresh": "npm run index && npm run backfill:cards && npm run probe:all && npm run assay:snapshot && npm run snapshot",
    "seed:books": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/seed-books.ts",
    "backfill:cards": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/backfill-cards.ts",
    "registry-tail": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/registry-tail.ts",
    "confirm-calls": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/confirm-calls.ts",
    "registry-mints": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/registry-mints.ts",
    "backfill-testnet-jobs": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/backfill-testnet-jobs.ts",
    "register-reference-testnet": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/register-reference-testnet.ts",
    "escrow-testnet-e2e": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/escrow-testnet-e2e.ts",
    "testnet-pack-ui": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/testnet-pack-ui.ts",
    "passkey-ui": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/passkey-ui.ts",
    "fund-test-wallet": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/fund-test-wallet.ts",
    "escrow-e2e": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/escrow-e2e.ts",
    "escrow-outside-e2e": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/escrow-outside-e2e.ts",
    "escrow-sdk-e2e": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/escrow-sdk-e2e.ts",
    "telegram-setup": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/telegram-setup.ts",
    "quest-e2e": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/quest-e2e.ts",
    "leash-e2e": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/leash-e2e.ts",
    "jobs-e2e": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/jobs-e2e.ts",
    "set-agent-uris": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/set-agent-uris.ts"
  },
  "dependencies": {
    "@altananetwork/sdk": "^0.7.1",
