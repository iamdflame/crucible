    "sybil": "tsx src/scripts/sybil-check.ts",
    "dedup": "tsx src/scripts/dedup-check.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "reclassify": "tsx --env-file=.env src/scripts/reclassify.ts",
    "funnel": "tsx src/scripts/funnel.ts",
    "abi": "python3 -c \"import json;a=json.load(open('contracts/out/MandateMarket.sol/MandateMarket.json'));open('src/lib/chain/abi.ts','w').write('/**\\n * MandateMarket ABI and bytecode, generated from the Foundry artifact.\\n *\\n * Regenerate with: npm run abi\\n */\\n\\nexport const MANDATE_MARKET_ABI = '+json.dumps(a['abi'],indent=2)+' as const;\\n\\nexport const MANDATE_MARKET_BYTECODE = '+json.dumps(a['bytecode']['object'])+' as \\`0x\\${string}\\`;\\n')\"",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "adjudicator": "tsx src/scripts/adjudicator.ts",
    "index": "tsx src/scripts/index-agents.ts",
    "agent": "tsx src/agents/run.ts",
    "settle": "tsx src/scripts/settle.ts",
    "grant": "tsx src/scripts/grant.ts",
    "verify": "tsx packages/mandate-verify/src/cli.ts",
    "verify:isolation": "node packages/mandate-verify/scripts/check-isolation.mjs",
    "advantage": "tsx --env-file=.env --env-file=.env.local src/scripts/advantage.ts",
    "advantage:lock": "tsx --env-file=.env --env-file=.env.local src/scripts/advantage-lock.ts",
    "advantage:report": "tsx src/scripts/advantage-report.ts",
    "prove-session": "tsx --env-file=.env --env-file=.env.local src/scripts/prove-session-scope.ts",
    "greenfield": "tsx --env-file=.env --env-file=.env.local src/scripts/greenfield.ts",
    "earn-capability": "tsx --env-file=.env --env-file=.env.local src/scripts/earn-capability.ts",
    "scope-audit": "tsx --env-file=.env --env-file=.env.local src/scripts/scope-audit.ts",
    "keeper": "tsx --env-file=.env --env-file=.env.local src/scripts/keeper.ts",
    "check:config": "tsx src/lib/config.check.ts",
    "prove-hire": "tsx --env-file=.env --env-file-if-exists=.env.local src/scripts/prove-hire.ts",
    "pool-gap": "tsx --env-file=.env --env-file=.env.local src/scripts/pool-gap.ts",
    "writeback": "tsx --env-file=.env --env-file=.env.local src/scripts/writeback.ts",
    "prove-x402": "tsx --env-file=.env --env-file=.env.local src/scripts/prove-x402.ts",
    "abi:v2": "tsx src/scripts/abi-v2.ts",
